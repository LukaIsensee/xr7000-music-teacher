# Point this at wherever Ollama is running (e.g. your DGX Spark's LAN IP).
# On the Spark: `OLLAMA_HOST=0.0.0.0 ollama serve` to accept connections from other devices.
OLLAMA_BASE_URL=http://localhost:11434

# ollama pull llama3.3:70b   (or qwen2.5:72b)
MODEL_NAME=llama3.3:70b

LLM_TIMEOUT_SECONDS=120
